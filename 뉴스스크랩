def search_news_by_period(
    keyword, start_dt, end_dt, client_id, client_secret, display=30
):
  """네이버 뉴스 검색 API를 통해 선택한 기간 내 보도된 기사 수집"""
  # API 키가 없는 경우 테스트용 샘플 데이터 반환
  if not client_id or not client_secret:
    random_hour = random.randint(8, 20)
    random_min = random.randint(0, 59)
    sample_dt = datetime.combine(start_dt, datetime.min.time()) + timedelta(
        hours=random_hour, minutes=random_min
    )
    return [
        {
            "keyword": keyword,
            "title": f"[{keyword}] 실제 뉴스 제목 샘플 예시입니다.",
            "content": f"이것은 {keyword}와 관련된 상세 테스트용 본문 설명입니다.",
            "date": sample_dt.strftime("%Y-%m-%d %H:%M:%S"),
            "link": "https://news.naver.com",
            "publisher": "메이저",
        }
    ]

  url = (
      f"https://openapi.naver.com/v1/search/news.json?query={keyword}"
      f"&display={display}&sort=date"
  )
  headers = {
      "X-Naver-Client-Id": client_id,
      "X-Naver-Client-Secret": client_secret,
  }

  try:
    response = requests.get(url, headers=headers)
    if response.status_code != 200:
      return []

    items = response.json().get("items", [])
    parsed_articles = []

    for item in items:
      pub_date_str = item["pubDate"]
      try:
        pub_dt = datetime.strptime(pub_date_str[5:25], "%d %b %Y %H:%M:%S")
      except:
        pub_dt = datetime.now()

      pub_date_only = pub_dt.date()

      if start_dt <= pub_date_only <= end_dt:
        title = re.sub(r"<.*?>", "", item["title"])
        description = re.sub(r"<.*?>", "", item["description"])
        # 실제 뉴스 기사로 정확히 이동하도록 네이버 뉴스 링크 사용
        link = item["link"]

        major_press = [
            "chosun",
            "joins",
            "donga",
            "hani",
            "khan",
            "mk",
            "hankyung",
            "yna",
            "sbs",
            "kbs",
            "mbc",
            "jtbc",
            "edaily",
            "머니투데이",
        ]
        publisher = (
            "메이저"
            if any(press in link for press in major_press)
            else "일반"
        )

        parsed_articles.append({
            "keyword": keyword,
            "title": title,
            "content": description,
            "date": pub_dt.strftime("%Y-%m-%d %H:%M:%S"),
            "link": link,
            "publisher": publisher,
        })

    return parsed_articles
  except Exception as e:
    return []


def process_and_sort_news(articles):
  """중복 제거 및 우선순위 정렬"""
  unique_articles = {}
  for article in articles:
    clean_title = re.sub(r"[^\w\s]", "", article["title"])
    if clean_title not in unique_articles:
      unique_articles[clean_title] = article

  filtered_list = list(unique_articles.values())

  sorted_articles = sorted(
      filtered_list,
      key=lambda x: (
          0 if x["publisher"] == "메이저" else 1,
          -len(x["content"]),
          x["date"],
      ),
      reverse=False,
  )
  return sorted_articles


